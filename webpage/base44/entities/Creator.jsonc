{
  "name": "Creator",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "tiktok_handle": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "approved_date": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "panel_pin": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "total_code_uses": {
      "type": "number",
      "default": 0
    },
    "commission_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "customer": {
            "type": "string"
          },
          "product": {
            "type": "string"
          },
          "sale_amount": {
            "type": "number"
          },
          "commission": {
            "type": "number"
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "order_pending",
              "pending",
              "paid",
              "cancelled"
            ],
            "default": "order_pending"
          }
        }
      }
    },
    "payout_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "date": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid"
            ],
            "default": "paid"
          }
        }
      }
    },
    "withdrawal_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string"
          },
          "bank_info": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "default": "pending"
          },
          "admin_note": {
            "type": "string"
          },
          "processed_date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "email",
    "whatsapp"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}