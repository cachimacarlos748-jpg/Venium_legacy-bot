NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/app.db

# Admin: use Basic Auth for /api/admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-exposing-the-panel

# Provider modes: mock is safe and default. live requires the matching secret.
VENIUM_MODE=mock
VENIUM_BASE_URL=https://veniumstore.com
VENIUM_API_KEY=

PABILO_MODE=mock
PABILO_BASE_URL=https://api.pabilo.app
PABILO_API_KEY=
PABILO_USER_BANK_ID=
PABILO_MOVEMENT_TYPE=GENERIC

# Gemini only extracts receipt fields; the backend and Pabilo decide validity.
GEMINI_MODE=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# live connects a WhatsApp Web device through Baileys. Scan the QR printed in logs.
WHATSAPP_MODE=disabled
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
WHATSAPP_ALLOW_GROUPS=false
WHATSAPP_RECONNECT_DELAY_MS=5000

# Webhook secret is used only by the Venium webhook endpoint.
VENIUM_WEBHOOK_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300